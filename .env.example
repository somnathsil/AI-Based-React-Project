# OpenRouter — used for AI query understanding + dashboard SVG generator
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_API_MODEL=

# Magnific AI paid account (e.g. business@massoftind.com)
# Create the key at: https://www.magnific.com/user/organization/api-keys
# Keep this server-side (no VITE_ prefix) — Vite proxy injects x-magnific-api-key
MAGNIFIC_API_KEY=
VITE_MAGNIFIC_ENABLED=true
# Required by Magnific text-to-icon API; results are polled, webhook is not handled in-app
VITE_MAGNIFIC_WEBHOOK_URL=https://example.com/magnific-webhook
